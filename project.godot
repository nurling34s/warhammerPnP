; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be modified
; by the editor when saving the project.
;
; It's still a valid text file, which you can adapt using any
; text editor / IDE, provided you know what you are doing.

config_version=5

[application]

config/name="Warhammer PnP"
config/description="Web tabletop assistant for Age of Sigmar (4th ed) and Warhammer 40,000 (11th ed) with a shared, data-driven rules engine."
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

EventBus="*res://core/autoload/event_bus.gd"
RulesetRegistry="*res://core/autoload/ruleset_registry.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
